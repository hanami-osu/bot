# Rename this file to `.env` before running the bot.
# Keep your real `.env` private. Do not commit it.

# =============================================================================
# Discord
# =============================================================================

# Discord bot token.
# Get it from: Discord Developer Portal > Applications > Your Bot > Bot > Token
DISCORD_BOT_TOKEN=""

# Your Discord user ID.
# Enable Developer Mode in Discord, then right click your profile and copy your ID.
OWNER_ID=""


# =============================================================================
# osu!
# =============================================================================

# osu! OAuth application client ID.
# Get it from: osu! website > Account Settings > OAuth > New OAuth Application
OSU_CLIENT_ID=""

# osu! OAuth application client secret.
# Get it from the same OAuth application page as OSU_CLIENT_ID.
OSU_CLIENT_SECRET=""

# Optional pre-generated osu! access token.
# Usually safe to leave empty unless you specifically know you need it.
OSU_ACCESS_TOKEN=""

# Optional osu!daily API key.
# Leave empty if osu!daily features are not configured.
OSU_DAILY_API=""

# Optional path where osu! token data should be stored.
# Leave empty to use the app's default behavior.
OSU_TOKEN_PATH=""


# =============================================================================
# Hanami
# =============================================================================

# A local Hanami web instance.
# This should lead to its root link.
HANAMI_WEB_URL="http://localhost:3000"

# Hanami link secret.
# This should match the web's.
HANAMI_LINK_SECRET="ccf8df1ad1abd4f49e3b7fa987ffb5102b318b41f789248559f8cc2383212684"


# =============================================================================
# Database
# =============================================================================

# Redis connection URL.
# Local Docker/default Redis example: redis://localhost:6379/0
REDIS_URL="redis://localhost:6379/0"

# MySQL database connection URL.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://dev:devpassword@localhost:3306/hanami"


# =============================================================================
# Development
# =============================================================================

# Discord channel ID where bot errors should be posted.
# Enable Developer Mode in Discord, then right click the channel and copy its ID.
ERROR_CHANNEL_ID=""

# Discord server ID used for development slash command registration.
# Enable Developer Mode in Discord, then right click your server and copy its ID.
DEV_GUILD_ID=""